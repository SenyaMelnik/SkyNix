{
  "name": "skynix",
  "version": "2.0.0",
  "description": "Official SkyNix application",
  "main": "main.js",
  "author": "Senya Melnik",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "work.skynix.app",
    "productName": "SkyNix",
    "protocols": [
      {
        "name": "SkyNix Discord Login",
        "schemes": [
          "skynix"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "SenyaMelnik",
      "repo": "SkyNix"
    }
  }
}
